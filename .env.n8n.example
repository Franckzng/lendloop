# Copy this file to .env.n8n and fill in the values. Never commit .env.n8n.

# Shared secret used to sign and verify every call between Convex and n8n.
# Generate one with:  openssl rand -hex 32
# The same value must be set in Convex:  npx convex env set N8N_WEBHOOK_SECRET <value>
LENDLOOP_WEBHOOK_SECRET=

# Public address of this n8n instance, with a trailing slash.
# Locally this is the tunnel address (see n8n/README.md).
N8N_WEBHOOK_URL=http://localhost:5678/

# n8n sits behind one proxy (the tunnel).
N8N_PROXY_HOPS=1

# Lets the Code nodes read LENDLOOP_WEBHOOK_SECRET from the environment,
# so the secret never has to be written inside a workflow.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Lets the Code nodes use Node's crypto module (HMAC, constant-time compare).
NODE_FUNCTION_ALLOW_BUILTIN=crypto

GENERIC_TIMEZONE=UTC
TZ=UTC
N8N_DIAGNOSTICS_ENABLED=false
